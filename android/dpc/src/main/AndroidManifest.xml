<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Location, for recovering a phone only (app 1.3+). Declared so the device
      owner can grant it for a single fix and take it away again: the server
      asks only for a locked or overdue phone whose customer signed an
      agreement allowing it, at a shop owner's request, and the customer is
      notified every time. See admin/LocationReporter.kt.

      Still deliberately absent: phone-state. Nothing needs the customer's
      number or call log.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AlmasApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="${networkSecurityConfig}"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlmasSdm">

        <activity
            android:name=".ui.StatusActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.EnrollActivity"
            android:exported="false"
            android:launchMode="singleTask" />

        <!-- "This phone is yours": shown once the shop has released the phone. -->
        <activity
            android:name=".ui.ReleasedActivity"
            android:exported="false"
            android:launchMode="singleTask" />

        <!--
          The lock screen.

          Its own task, excluded from recents, and it cannot be left by the back
          key. It does NOT declare itself a home activity here: an unlocked
          phone must not offer this app in the launcher chooser. The alias below
          carries the HOME filter and is enabled only while a lock is in force.
        -->
        <activity
            android:name=".ui.LockActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:taskAffinity="pk.almassdm.dpc.lock"
            android:theme="@style/Theme.AlmasSdm.Lock" />

        <activity-alias
            android:name=".ui.LockHomeAlias"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".ui.LockActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".admin.AlmasDeviceAdminReceiver"
            android:description="@string/admin_description"
            android:exported="true"
            android:label="@string/admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".work.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
