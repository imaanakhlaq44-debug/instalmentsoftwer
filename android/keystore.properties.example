# Copy to android/keystore.properties and fill in. That file is git-ignored and
# must stay that way: it is the only thing standing between someone else and an
# APK that a factory-reset phone will accept as its device owner.
#
# CI does not use this file — it reads the same four values from the
# environment (ALMAS_KEYSTORE_FILE, ALMAS_KEYSTORE_PASSWORD, ALMAS_KEY_ALIAS,
# ALMAS_KEY_PASSWORD).
#
# See RELEASE.md for how to create the keystore and where to keep it.

storeFile=C:/keys/almas-sdm-release.jks
storePassword=
keyAlias=almas-sdm
keyPassword=
