<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. The release build uses network_security_config.xml, which
  permits no plaintext at all.

  This one allows it, because a handset being tested on a shop's bench talks to
  a laptop on the same Wi-Fi over http://192.168.x.x — an address that cannot be
  named ahead of time and that Android's config format cannot express as a
  range. The previous version listed only the emulator's loopback alias, which
  is why a real phone could reach the server and still refuse to speak to it.

  Nothing here ships: `debuggable` builds are the only ones that reference it,
  and a release APK signed for distribution carries the strict config instead.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
