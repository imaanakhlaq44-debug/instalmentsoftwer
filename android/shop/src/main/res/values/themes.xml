<resources>
    <style name="Theme.AlmasShop" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/navy</item><item name="colorSecondary">@color/mint</item>
        <item name="android:windowBackground">@color/paper</item><item name="android:colorAccent">@color/navy</item>
        <item name="android:statusBarColor">@color/paper</item><item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item><item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.AlmasShop.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/brand_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.AlmasShop</item>
    </style>
</resources>
