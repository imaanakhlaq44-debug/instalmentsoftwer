# ==========================================================
# Almas SDM — Server Environment Configuration
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# NEVER commit the real .env file.
# ==========================================================

# Runtime environment: development | production | test
NODE_ENV=development

# HTTP port for the REST API
PORT=5000

# ----------------------------------------------------------
# DATABASE (REQUIRED)
# ----------------------------------------------------------
# PostgreSQL connection string.
#
# Local development with no PostgreSQL installed:
#   npm run db:dev      (runs real PostgreSQL binaries on port 5433, no install)
# then use the URL below as-is.
#
# Production: point this at your real PostgreSQL server.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/emishield"

# Connection pool size. 20 or more in production; a smaller pool is fine locally.
DB_POOL_MAX=10

# ----------------------------------------------------------
# SECURITY (REQUIRED IN PRODUCTION)
# ----------------------------------------------------------
# Secret used to sign JWT access tokens.
# Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server REFUSES to start in production if this is missing or weak.
JWT_SECRET=

# How long an access token stays valid (e.g. 15m, 1h, 12h)
JWT_EXPIRES_IN=12h

# bcrypt cost factor. 10 = fast, 12 = recommended for production.
BCRYPT_ROUNDS=12

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------
# Comma-separated list of allowed browser origins.
# In production this MUST be your real dashboard domain.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------
# General API limit: max requests per IP per window
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=500

# Login endpoint limit (brute-force protection)
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10

# ----------------------------------------------------------
# ANDROID DPC (the app on the customer's phone — see android/dpc/)
# ----------------------------------------------------------
# The base URL the handset calls. It must be reachable FROM THE PHONE, so
# "localhost" only works on an emulator (use http://10.0.2.2:5000/api/dpc there).
# In production this must be HTTPS: a release build of the DPC refuses plaintext.
DPC_SERVER_URL=http://10.0.2.2:5000/api/dpc

# Where a factory-reset phone downloads the DPC from during setup, and the
# checksum of the certificate it was signed with. WITHOUT BOTH, the enrollment
# QR cannot provision a new phone — the dashboard will say so when you generate
# one. Produce the checksum from your signing certificate with:
#   keytool -printcert -jarfile app-release.apk | grep SHA256
# then base64url-encode those bytes (no padding).
DPC_APK_URL=
DPC_APK_SIGNATURE_CHECKSUM=

# The device admin component inside the APK. Change only if you rename it.
DPC_ADMIN_COMPONENT=pk.almassdm.dpc/pk.almassdm.dpc.admin.AlmasDeviceAdminReceiver

# Keep the phone a normal phone: system apps stay enabled after provisioning.
DPC_LEAVE_SYSTEM_APPS_ENABLED=true

# ----------------------------------------------------------
# DEMO / SEEDING
# ----------------------------------------------------------
# Auto-seed the demo dataset when the database is empty.
# MUST be false in production.
AUTO_SEED=true

# Default password assigned to seeded demo users (hashed before storage).
# Change this and re-seed before any real deployment.
# Quote the value if it contains "#", otherwise dotenv reads it as a comment.
SEED_DEFAULT_PASSWORD="ChangeMe#2026"

# ----------------------------------------------------------
# WHATSAPP BUSINESS CLOUD API (optional — OFF when all are blank)
# ----------------------------------------------------------
# The "WhatsApp" button in the dashboard needs NONE of this: it opens the
# shop's own WhatsApp with the message typed in.
#
# These variables switch on automatic sending through Meta's WhatsApp Business
# Cloud API. Leave every one blank to keep it off. Setting only some of them
# is an error and the server REFUSES TO START — a half-configured channel
# would look as though reminders were going out.
#
# What you need from Meta (business.facebook.com / developers.facebook.com):
#   1. A Meta Business account, verified.
#   2. A WhatsApp Business Account with a phone number registered to it. That
#      number can no longer be used in the ordinary WhatsApp app.
#   3. A permanent access token for a System User with the
#      "whatsapp_business_messaging" permission.
#   4. A message template APPROVED by Meta, with exactly three body
#      placeholders:  {{1}} customer name, {{2}} the message, {{3}} shop name
#      and phone. For example:
#        Assalam o Alaikum {{1}}, {{2}} — {{3}}
#   5. A payment method on the account: Meta charges per template message.
#
# NEVER commit real values. The token is a password.

# Permanent System User access token.
WHATSAPP_CLOUD_ACCESS_TOKEN=

# The numeric "Phone number ID" from WhatsApp > API Setup. NOT the phone number.
WHATSAPP_CLOUD_PHONE_NUMBER_ID=

# Graph API version shown on the same page, e.g. v21.0
WHATSAPP_CLOUD_API_VERSION=

# Name of the approved template, and the language code it was approved in
# (ur, en, en_US ...).
WHATSAPP_CLOUD_TEMPLATE_NAME=
WHATSAPP_CLOUD_TEMPLATE_LANGUAGE=

# Optional: a different approved template for one kind of message. Each must
# take the same three placeholders. Types: PAYMENT_DUE, PAYMENT_OVERDUE,
# DEVICE_LOCKED, DEVICE_UNLOCKED, DEVICE_OFFLINE, ENROLLMENT_SUCCESS, SECURITY_ALERT
# WHATSAPP_CLOUD_TEMPLATE_PAYMENT_DUE=
# WHATSAPP_CLOUD_TEMPLATE_PAYMENT_OVERDUE=

# Optional: override the API host. Leave unset for https://graph.facebook.com
# WHATSAPP_CLOUD_API_BASE_URL=
