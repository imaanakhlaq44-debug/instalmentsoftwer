# ==========================================================
# EMI Shield — Server Environment Configuration
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# NEVER commit the real .env file.
# ==========================================================

# Runtime environment: development | production | test
NODE_ENV=development

# HTTP port for the REST API
PORT=5000

# ----------------------------------------------------------
# DATABASE (REQUIRED)
# ----------------------------------------------------------
# PostgreSQL connection string.
#
# Local development with no PostgreSQL installed:
#   npm run db:dev      (runs real PostgreSQL binaries on port 5433, no install)
# then use the URL below as-is.
#
# Production: point this at your real PostgreSQL server.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/emishield"

# Connection pool size. 20 or more in production; a smaller pool is fine locally.
DB_POOL_MAX=10

# ----------------------------------------------------------
# SECURITY (REQUIRED IN PRODUCTION)
# ----------------------------------------------------------
# Secret used to sign JWT access tokens.
# Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server REFUSES to start in production if this is missing or weak.
JWT_SECRET=

# How long an access token stays valid (e.g. 15m, 1h, 12h)
JWT_EXPIRES_IN=12h

# bcrypt cost factor. 10 = fast, 12 = recommended for production.
BCRYPT_ROUNDS=12

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------
# Comma-separated list of allowed browser origins.
# In production this MUST be your real dashboard domain.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------
# General API limit: max requests per IP per window
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=500

# Login endpoint limit (brute-force protection)
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10

# ----------------------------------------------------------
# ANDROID DPC (the app on the customer's phone — see android/dpc/)
# ----------------------------------------------------------
# The base URL the handset calls. It must be reachable FROM THE PHONE, so
# "localhost" only works on an emulator (use http://10.0.2.2:5000/api/dpc there).
# In production this must be HTTPS: a release build of the DPC refuses plaintext.
DPC_SERVER_URL=http://10.0.2.2:5000/api/dpc

# Where a factory-reset phone downloads the DPC from during setup, and the
# checksum of the certificate it was signed with. WITHOUT BOTH, the enrollment
# QR cannot provision a new phone — the dashboard will say so when you generate
# one. Produce the checksum from your signing certificate with:
#   keytool -printcert -jarfile app-release.apk | grep SHA256
# then base64url-encode those bytes (no padding).
DPC_APK_URL=
DPC_APK_SIGNATURE_CHECKSUM=

# The device admin component inside the APK. Change only if you rename it.
DPC_ADMIN_COMPONENT=pk.emishield.dpc/pk.emishield.dpc.admin.EmiDeviceAdminReceiver

# Keep the phone a normal phone: system apps stay enabled after provisioning.
DPC_LEAVE_SYSTEM_APPS_ENABLED=true

# ----------------------------------------------------------
# DEMO / SEEDING
# ----------------------------------------------------------
# Auto-seed the demo dataset when the database is empty.
# MUST be false in production.
AUTO_SEED=true

# Default password assigned to seeded demo users (hashed before storage).
# Change this and re-seed before any real deployment.
# Quote the value if it contains "#", otherwise dotenv reads it as a comment.
SEED_DEFAULT_PASSWORD="ChangeMe#2026"
