# ==========================================================
# Almas SDM — Server Environment Configuration
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# NEVER commit the real .env file.
# ==========================================================

# Runtime environment: development | production | test
NODE_ENV=development

# HTTP port for the REST API
PORT=5000

# ----------------------------------------------------------
# DATABASE (REQUIRED)
# ----------------------------------------------------------
# PostgreSQL connection string.
#
# Local development with no PostgreSQL installed:
#   npm run db:dev      (runs real PostgreSQL binaries on port 5433, no install)
# then use the URL below as-is.
#
# Production: point this at your real PostgreSQL server.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/emishield"

# Connection pool size. 20 or more in production; a smaller pool is fine locally.
DB_POOL_MAX=10

# ----------------------------------------------------------
# SECURITY (REQUIRED IN PRODUCTION)
# ----------------------------------------------------------
# Secret used to sign JWT access tokens.
# Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server REFUSES to start in production if this is missing or weak.
JWT_SECRET=

# How long an access token stays valid (e.g. 15m, 1h, 12h)
JWT_EXPIRES_IN=12h

# bcrypt cost factor. 10 = fast, 12 = recommended for production.
BCRYPT_ROUNDS=12

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------
# Comma-separated list of allowed browser origins.
# In production this MUST be your real dashboard domain.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------
# General API limit: max requests per IP per window
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=500

# Login endpoint limit (brute-force protection)
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10

# ----------------------------------------------------------
# ANDROID DPC (the app on the customer's phone — see android/dpc/)
# ----------------------------------------------------------
# The base URL the handset calls. It must be reachable FROM THE PHONE, so
# "localhost" only works on an emulator (use http://10.0.2.2:5000/api/dpc there).
# In production this must be HTTPS: a release build of the DPC refuses plaintext.
DPC_SERVER_URL=http://10.0.2.2:5000/api/dpc

# Where a factory-reset phone downloads the DPC from during setup, and the
# checksum of the certificate it was signed with. WITHOUT BOTH, the enrollment
# QR cannot provision a new phone — the dashboard will say so when you generate
# one. Produce the checksum from your signing certificate with:
#   keytool -printcert -jarfile app-release.apk | grep SHA256
# then base64url-encode those bytes (no padding).
DPC_APK_URL=
DPC_APK_SIGNATURE_CHECKSUM=

# The device admin component inside the APK. Change only if you rename it.
DPC_ADMIN_COMPONENT=pk.almassdm.dpc/pk.almassdm.dpc.admin.AlmasDeviceAdminReceiver

# Keep the phone a normal phone: system apps stay enabled after provisioning.
DPC_LEAVE_SYSTEM_APPS_ENABLED=true

# ----------------------------------------------------------
# SMS AGGREGATOR (optional — branded sender mask, volume)
# ----------------------------------------------------------
# Without this section reminders go out only through a shop's paired phone.
# With it, each shop can choose (Settings -> "How SMS are sent") between its
# paired phone, this gateway, or this gateway with the phone as a fallback.
#
# REAL CREDENTIALS GO IN `.env` ON THE SERVER ONLY. Never in this file, never
# in the repository.
#
# Which provider:  none | http | twilio
SMS_PROVIDER=none

# The sender mask (brand name) your operator approved, e.g. ALMAS SDM.
SMS_SENDER_MASK=

# --- SMS_PROVIDER=http : any gateway that takes one HTTP request per SMS ----
# This is how nearly every Pakistani corporate / branded SMS gateway works.
# Your gateway's "HTTP API" or "Developer API" document gives you each value.
#
# The send URL from that document.
SMS_HTTP_URL=
# GET or POST. For POST, how the fields are sent: form | json
SMS_HTTP_METHOD=GET
SMS_HTTP_BODY_FORMAT=form

# Your account. Fill in whichever your gateway uses; leave the rest empty.
SMS_HTTP_USERNAME=
SMS_HTTP_PASSWORD=
SMS_HTTP_API_KEY=

# What YOUR gateway calls each field. These are names, not secrets — copy them
# from the example URL in the gateway's document. For instance, for
#   https://gateway.example/api/send?id=USER&pass=PASSWORD&mask=BRAND&to=923..&msg=TEXT
# set PARAM_USERNAME=id, PARAM_PASSWORD=pass, PARAM_SENDER=mask, PARAM_TO=to,
# PARAM_MESSAGE=msg. Set a name to empty to leave that field out entirely.
SMS_HTTP_PARAM_USERNAME=username
SMS_HTTP_PARAM_PASSWORD=password
SMS_HTTP_PARAM_API_KEY=api_key
SMS_HTTP_PARAM_SENDER=sender
SMS_HTTP_PARAM_TO=to
SMS_HTTP_PARAM_MESSAGE=message

# How the customer's number is written:
#   international  923001234567   (most Pakistani gateways)
#   plus           +923001234567
#   local          03001234567
SMS_HTTP_PHONE_FORMAT=international

# Fixed extra fields sent with every message, e.g.  format=json&network=all
SMS_HTTP_EXTRA_PARAMS=
# Extra fields sent ONLY when the message contains Urdu script (or any other
# non-English character). Most gateways need to be told, e.g.  type=unicode
# or  lang=urdu . Without it an Urdu SMS usually arrives as "????".
SMS_HTTP_UNICODE_PARAMS=
# For gateways that take a token in a header instead of fields, e.g.
#   SMS_HTTP_AUTH_HEADER="Authorization: Bearer <token>"
SMS_HTTP_AUTH_HEADER=

# How to read the gateway's reply. A message is marked SENT only when the
# gateway accepted it. Many gateways answer "HTTP 200" even to a refusal, so:
#   SUCCESS_PATTERN  if set, the reply MUST contain this (regex, case-insensitive)
#                    e.g.  "success|sent successfully"  or  "\"status\":\s*\"ok\""
#   FAILURE_PATTERN  a reply containing this is a refusal. Used when no success
#                    pattern is set; the default catches error/fail/invalid/
#                    unauthorized/insufficient and similar words.
#   MESSAGE_ID_PATTERN  optional; the first (...) group is kept as the
#                    gateway's message id, e.g.  "id[=:]\s*(\d+)"
SMS_HTTP_SUCCESS_PATTERN=
SMS_HTTP_FAILURE_PATTERN=
SMS_HTTP_MESSAGE_ID_PATTERN=

# --- SMS_PROVIDER=twilio ----------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sender: an alphanumeric sender id or a Twilio number. Falls back to
# SMS_SENDER_MASK. Or use a messaging service instead.
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# --- Shared tuning (the defaults are sensible) ------------------------------
# Seconds one gateway call may take, in milliseconds.
SMS_TIMEOUT_MS=10000
# Tries per message through the gateway (waits: 1 min, 5 min, 30 min, 2 h).
# After the last one the message is FAILED, or handed to the paired phone for
# a shop on "gateway, then phone".
SMS_MAX_ATTEMPTS=4
# How often the queue is checked, in seconds.
SMS_POLL_SECONDS=30

# ----------------------------------------------------------
# DEMO / SEEDING
# ----------------------------------------------------------
# Auto-seed the demo dataset when the database is empty.
# MUST be false in production.
AUTO_SEED=true

# Default password assigned to seeded demo users (hashed before storage).
# Change this and re-seed before any real deployment.
# Quote the value if it contains "#", otherwise dotenv reads it as a comment.
SEED_DEFAULT_PASSWORD="ChangeMe#2026"
