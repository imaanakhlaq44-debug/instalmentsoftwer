# One origin for everything.
#
# The dashboard calls the API at the relative path `/api`, so the two must be
# served from the same host — that is what keeps the browser from ever seeing a
# cross-origin request, and why there is no CORS conversation on this side.
# The handset's DPC talks to the same `/api/dpc` prefix through the same
# certificate.

{
	# Where Let's Encrypt sends expiry warnings. Set it: a certificate that fails
	# to renew takes the whole fleet offline, and this is the only warning.
	email {$ADMIN_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Every response, API included: HTTPS only from now on, and no guessing at
	# content types. (The API adds its own stricter headers through helmet.)
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# The dashboard's own pages. The API's JSON keeps helmet's CSP, so this is
	# scoped away from /api/*.
	#
	# Why each source is allowed:
	#   wasm-unsafe-eval   the CNIC scanner runs Tesseract as WebAssembly
	#   blob: (worker)     Tesseract starts its worker from a blob URL
	#   blob:/data: (img)  camera photos, QR codes and previews before upload
	#   Google Fonts       index.html loads the interface fonts from there
	#   'unsafe-inline'    styles only — React style props and the font CSS
	#   form-action https: a hosted payment checkout posts the browser to the
	#                      gateway's own page (JazzCash), off-origin by design
	# The shop's dashboard is never framed: frame-ancestors/X-Frame-Options stop
	# another site from overlaying it to trick a click on "Lock" or "Verify".
	@dashboard not path /api/*
	header @dashboard {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'self' https:; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
	}

	# The API, including the DPC endpoints the handsets use.
	handle /api/* {
		reverse_proxy server:5000 {
			# The rate limiter and the audit log record who made a request, and
			# without these every request would appear to come from Caddy.
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# The dashboard: a single-page app, so any unknown path is its router's
	# business rather than a 404.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Long cache for fingerprinted assets, none for the entry point — otherwise a
	# deployed fix sits behind a stale index.html in somebody's browser.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	@shopApk path /downloads/almas-sdm-shop-*.apk
	header @shopApk {
		Content-Type application/vnd.android.package-archive
		Content-Disposition attachment
		Cache-Control "public, max-age=31536000, immutable"
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
