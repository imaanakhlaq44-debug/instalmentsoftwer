# Copy to deploy/.env on the VPS and fill in. That file is git-ignored and holds
# the database password and the JWT secret, so it never leaves the server.
#
#     cp deploy/.env.example deploy/.env

# ---------------------------------------------------------------------------
# The address customers' handsets will be told to trust
# ---------------------------------------------------------------------------
# Must be a real domain pointing at this VPS, not an IP. Caddy obtains the TLS
# certificate for exactly this name, and the DPC's release build refuses
# plaintext HTTP — so until DNS resolves here, no handset can check in.
SITE_DOMAIN=almassdm.example.pk

# Where Let's Encrypt sends certificate-expiry warnings. A real inbox somebody
# reads: this is the only notice before the fleet goes offline.
ADMIN_EMAIL=owner@example.pk

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=almas
POSTGRES_DB=almas_sdm
# Generate one and never type it again:
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# The server refuses to start in production without this, and refuses a short or
# a known-published one. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it later signs everybody out; it does not lose any data.
JWT_SECRET=
JWT_EXPIRES_IN=12h

DB_POOL_MAX=20

# ---------------------------------------------------------------------------
# Provisioning — from the DPC release notes
# ---------------------------------------------------------------------------
# Both come from the GitHub Release that published the handset build. Until they
# are set, the Enrollment page prints the QR and says plainly that it cannot
# provision a factory-reset phone.
#
# `DPC_SERVER_URL` is not here: compose derives it from SITE_DOMAIN, because a
# handset pointed at a different host than the one holding the certificate is a
# fleet that silently stops checking in.
DPC_APK_URL=
DPC_APK_SIGNATURE_CHECKSUM=
